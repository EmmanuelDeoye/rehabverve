            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    },
    "submissions": {
      "$classId": {
        "$aid": {
          ".read": "auth != null && ((auth != null && root.child('admins/' + auth.uid).val() === true) || root.child('classes/' + $classId + '/tutorId').val() === auth.uid)",
          ".write": "auth != null && ((auth != null && root.child('admins/' + auth.uid).val() === true) || root.child('classes/' + $classId + '/tutorId').val() === auth.uid)",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "text": {
              ".write": "(auth.uid === $uid && (auth != null && !root.child('blocked/' + auth.uid).exists()) && root.child('enrollments/' + $classId + '/' + auth.uid + '/status').val() === 'active' && root.child('assignments/' + $classId + '/' + $aid).exists())",
              ".validate": "newData.isString() && newData.val().length <= 10000"
            },
            "fileUrl": {
              ".write": "(auth.uid === $uid && (auth != null && !root.child('blocked/' + auth.uid).exists()) && root.child('enrollments/' + $classId + '/' + auth.uid + '/status').val() === 'active' && root.child('assignments/' + $classId + '/' + $aid).exists())",
              ".validate": "newData.isString() && newData.val().length <= 2000 && newData.val().matches(/^(https:\\/\\/|assets\\/)/)"
            },
            "fileName": {
              ".write": "(auth.uid === $uid && (auth != null && !root.child('blocked/' + auth.uid).exists()) && root.child('enrollments/' + $classId + '/' + auth.uid + '/status').val() === 'active' && root.child('assignments/' + $classId + '/' + $aid).exists())",
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "submittedAt": {
              ".write": "(auth.uid === $uid && (auth != null && !root.child('blocked/' + auth.uid).exists()) && root.child('enrollments/' + $classId + '/' + auth.uid + '/status').val() === 'active' && root.child('assignments/' + $classId + '/' + $aid).exists())",
              ".validate": "newData.isNumber() && newData.val() <= now + 600000"
            },
            "studentName": {
              ".write": "(auth.uid === $uid && (auth != null && !root.child('blocked/' + auth.uid).exists()) && root.child('enrollments/' + $classId + '/' + auth.uid + '/status').val() === 'active' && root.child('assignments/' + $classId + '/' + $aid).exists())",
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "grade": {
              ".validate": "newData.isString() && newData.val().length <= 40"
