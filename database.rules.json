        "last_changed": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "profileViews": {
      "$uid": {
        ".read": "((auth != null && auth.uid === $uid) || (auth != null && root.child('admins/' + auth.uid).val() === true))",
        ".write": "auth != null && auth.uid !== $uid",
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      }
    },
    "bookings": {
      ".read": "((auth != null && root.child('admins/' + auth.uid).val() === true) || (auth != null && query.orderByChild == 'userId' && query.equalTo == auth.uid) || (auth != null && query.orderByChild == 'proId' && query.equalTo == auth.uid))",
      ".indexOn": [
        "userId",
        "proId",
        "status",
        "createdAt"
      ],
      "$id": {
        ".read": "((auth != null && root.child('admins/' + auth.uid).val() === true) || (auth != null && (data.child('userId').val() === auth.uid || data.child('proId').val() === auth.uid)))",
        ".write": "((auth != null && root.child('admins/' + auth.uid).val() === true) || (!data.exists() && newData.child('userId').val() === auth.uid && newData.child('status').val() === 'new' && (auth != null && !root.child('blocked/' + auth.uid).exists())))",
        ".validate": "newData.hasChildren(['userId', 'type', 'status', 'createdAt'])",
        "userId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "type": {
          ".validate": "newData.isString() && newData.val().matches(/^(teletherapy|intake|home-visit|consultation|tutoring|clinic)$/)"
        },
        "status": {
          ".write": "((data.parent().child('userId').val() === auth.uid && newData.val() === 'cancelled') || (data.parent().child('proId').val() === auth.uid && newData.isString() && newData.val().matches(/^(confirmed|completed)$/)))",
          ".validate": "newData.isString() && newData.val().matches(/^(new|contacted|confirmed|completed|cancelled)$/)"
        },
        "updatedAt": {
          ".write": "auth != null && (data.parent().child('userId').val() === auth.uid || data.parent().child('proId').val() === auth.uid)",
          ".validate": "newData.isNumber()"
        },
        "service": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "audience": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "plan": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "preferredDate": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "timeOfDay": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "notes": {
          ".validate": "newData.isString() && newData.val().length <= 3000"
        },
        "location": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "proId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "proName": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "userEmail": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "adminNote": {
          ".validate": "newData.isString() && newData.val().length <= 3000"
        },
        "scheduledAt": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "meetingLink": {
          ".validate": "newData.isString() && newData.val().length <= 2000 && newData.val().matches(/^(https:\\/\\/|assets\\/)/)"
        },
        "price": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "intake": {
          "$q": {
            ".validate": "newData.isString() && newData.val().length <= 600"
          }
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "classes": {
      ".read": true,
      ".write": "(auth != null && root.child('admins/' + auth.uid).val() === true)",
      ".indexOn": [
        "status",
