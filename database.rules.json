        "createdAt"
      ]
    },
    "classPrivate": {
      "$classId": {
        ".read": "auth != null && ((auth != null && root.child('admins/' + auth.uid).val() === true) || root.child('classes/' + $classId + '/tutorId').val() === auth.uid || root.child('enrollments/' + $classId + '/' + auth.uid + '/status').val() === 'active')",
        ".write": "auth != null && ((auth != null && root.child('admins/' + auth.uid).val() === true) || root.child('classes/' + $classId + '/tutorId').val() === auth.uid)",
        "meetingLink": {
          ".validate": "newData.isString() && newData.val().length <= 2000 && newData.val().matches(/^(https:\\/\\/|assets\\/)/)"
