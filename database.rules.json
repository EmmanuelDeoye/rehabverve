        ".write": "auth != null && ((auth != null && root.child('admins/' + auth.uid).val() === true) || root.child('classes/' + $classId + '/tutorId').val() === auth.uid)",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "(auth.uid === $uid && (auth != null && !root.child('blocked/' + auth.uid).exists()) && ((!data.exists() && newData.child('status').val() === 'pending' && root.child('classes/' + $classId + '/status').val() === 'open') || !newData.exists()))",
          ".validate": "newData.hasChildren(['childName', 'status', 'createdAt'])",
