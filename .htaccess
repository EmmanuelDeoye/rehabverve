# Only used if the site is ever hosted on Apache; GitHub Pages ignores this file.
RewriteEngine On

# Force HTTPS + www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.rehabverve\.com\.ng$ [NC]
RewriteRule ^ https://www.rehabverve.com.ng%{REQUEST_URI} [L,R=301]

# Clean URLs without breaking .html links
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

ErrorDocument 404 /404.html
